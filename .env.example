# ---------------------------------------------------------------------------
# Container-Ratgeber.de – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage deine echten IDs ein.
# Alle PUBLIC_*-Variablen landen im ausgelieferten Frontend.
# Ohne gesetzte Werte lädt KEIN Tracking/Werbe-Skript (datenschutzfreundlich).
# ---------------------------------------------------------------------------

# Google Analytics 4 – Mess-ID (Format: G-XXXXXXXXXX)
# Aktiviert gtag.js zusammen mit Google Consent Mode v2.
PUBLIC_GA_ID=

# Google Tag Manager – Container-ID (Format: GTM-XXXXXXX)
# Optional, falls du Tags lieber über den GTM verwaltest.
PUBLIC_GTM_ID=

# Google AdSense – Kundennummer/Publisher-ID (Format: ca-pub-XXXXXXXXXXXXXXXX)
# Sobald gesetzt, werden aus den Werbeplatz-Platzhaltern echte Anzeigen.
PUBLIC_ADSENSE_CLIENT=
