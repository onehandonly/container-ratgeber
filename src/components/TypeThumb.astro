---
/**
 * Vorschaubild eines Container-Typs (echtes Foto aus public/img/photos).
 * Fehlt die Datei, bleibt eine dezente Fläche in Markenfarbe stehen.
 */
interface Props {
  slug: string;
  alt?: string;
  /** "card" = breites Kartenbild, "chip" = kleines quadratisches Vorschaubild. */
  shape?: 'card' | 'chip';
  class?: string;
}
const { slug, alt = '', shape = 'card', class: cls = '' } = Astro.props;
---
<span class={`thumb thumb--${shape} ${cls}`}>
  <img
    src={`/img/photos/type-${slug}.webp`}
    alt={alt}
    loading="lazy"
    decoding="async"
    onerror="this.style.display='none'"
  />
</span>

<style>
  .thumb {
    display: block; overflow: hidden; border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-bg-sunken), var(--color-bg-alt));
    flex-shrink: 0;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb--card { aspect-ratio: 16 / 10; width: 100%; }
  .thumb--chip { width: 3.25rem; height: 3.25rem; border-radius: var(--radius-sm); }
</style>
