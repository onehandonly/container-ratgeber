---
interface Props {
  /** "light" für dunkle Hintergründe (Footer), sonst helle Umgebung (Header). */
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: cls = '' } = Astro.props;
---
<span class={`logo logo--${variant} ${cls}`}>
  {/* Querformat-Logo (Container + Schriftzug, transparent). Im Footer liegt es
      auf einem hellen Feld, da die dunkelblaue Schrift sonst kaum lesbar wäre. */}
  <img
    class="logo__full"
    src="/img/logo-header.webp"
    alt="Container-Ratgeber.de"
    width="900" height="216"
    loading={variant === 'light' ? 'lazy' : 'eager'}
    decoding="async"
    fetchpriority={variant === 'light' ? undefined : 'high'}
  />
</span>

<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; line-height: 1; }
  .logo__full { display: block; height: 4.05rem; width: auto; }
  /* Footer: helles Feld, damit die dunkle Schrift lesbar bleibt. */
  .logo--light { background: #fff; border-radius: 0.7rem; padding: 0.45rem 0.8rem; }
  .logo--light .logo__full { height: 3.4rem; }
  @media (max-width: 640px) {
    .logo__full { height: 2.9rem; }
    .logo--light .logo__full { height: 3rem; }
  }
</style>
