---
interface Props {
  /** "light" für dunkle Hintergründe (Footer), sonst helle Umgebung. */
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: cls = '' } = Astro.props;
const word = variant === 'light' ? '#ffffff' : 'var(--color-ink)';
const accent = variant === 'light' ? '#6ea8ff' : 'var(--brand-indigo-2)';
---
<span class={`logo logo--${variant} ${cls}`} aria-label="Container-Ratgeber.de">
  {/* Container-Bildmarke (public/img/logo.png). Fehlt die Datei, wird das <img>
      per onerror entfernt und nur der Schriftzug bleibt sichtbar. */}
  <img
    src="/img/logo.png"
    alt=""
    class="logo__img"
    width="120" height="80" loading="eager" decoding="async"
    onerror="this.remove()"
  />
  <span class="logo__word" style={`color:${word}`}>container<span style={`color:${accent}`}>-ratgeber</span></span>
</span>

<style>
  .logo { display: inline-flex; flex-direction: column; align-items: center; gap: 0.3rem; text-decoration: none; line-height: 1; }
  .logo__img { display: block; height: 2.6rem; width: auto; }
  .logo__word { font-family: var(--font-head); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; }
  /* Auf dunklem Grund (Footer): die freigestellte Skizze in ein helles Kärtchen
     fassen, damit die dunklen Graphitlinien sichtbar bleiben. */
  .logo--light .logo__img { background: #fff; padding: 0.3rem 0.5rem; border-radius: 0.6rem; height: 2.6rem; }
  @media (max-width: 520px) {
    .logo__img { height: 2.2rem; }
    .logo__word { font-size: 1rem; }
  }
</style>
