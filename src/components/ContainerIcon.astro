---
/**
 * Selbst gezeichnete, flache SVG-Illustrationen für Containertypen und
 * Ratgeber-Themen. Keine externen Bilder -> keine Copyright-Fragen.
 * Verwendung: <ContainerIcon name="buero" />
 */
interface Props {
  name?: string;
  class?: string;
  title?: string;
}
const { name = 'container', class: cls = '', title } = Astro.props;
const S = 'var(--color-signal)';
const D = 'var(--color-signal-dark)';
const INK = 'var(--color-ink)';
const LINE = 'var(--color-border-strong)';
const PAPER = 'var(--color-bg-alt)';
---
<svg viewBox="0 0 120 84" class={`cicon ${cls}`} role="img" aria-label={title ?? name} xmlns="http://www.w3.org/2000/svg">
  {title && <title>{title}</title>}
  <rect x="1" y="1" width="118" height="82" rx="8" fill={PAPER}/>

  {name === 'container' && (
    <g>
      <rect x="24" y="30" width="72" height="34" rx="2" fill={S}/>
      <g fill={D}><rect x="32" y="34" width="4" height="26"/><rect x="44" y="34" width="4" height="26"/><rect x="56" y="34" width="4" height="26"/><rect x="68" y="34" width="4" height="26"/><rect x="80" y="34" width="4" height="26"/></g>
      <g fill="#fff"><rect x="24" y="30" width="8" height="6"/><rect x="88" y="30" width="8" height="6"/><rect x="24" y="58" width="8" height="6"/><rect x="88" y="58" width="8" height="6"/></g>
    </g>
  )}

  {name === 'bau' && (
    <g>
      <rect x="20" y="34" width="60" height="30" rx="2" fill={S}/>
      <g fill={D}><rect x="27" y="38" width="3.5" height="22"/><rect x="37" y="38" width="3.5" height="22"/><rect x="47" y="38" width="3.5" height="22"/><rect x="57" y="38" width="3.5" height="22"/><rect x="67" y="38" width="3.5" height="22"/></g>
      <rect x="84" y="20" width="6" height="44" fill={INK}/>
      <rect x="84" y="20" width="26" height="5" fill={INK}/>
      <line x1="106" y1="25" x2="106" y2="34" stroke={INK} stroke-width="2"/>
      <path d="M101 34h10l-2 7h-6z" fill={D}/>
    </g>
  )}

  {name === 'buero' && (
    <g>
      <rect x="22" y="28" width="76" height="36" rx="2" fill={S}/>
      <g fill="#fff"><rect x="30" y="35" width="14" height="12" rx="1"/><rect x="53" y="35" width="14" height="12" rx="1"/><rect x="76" y="35" width="14" height="12" rx="1"/></g>
      <rect x="53" y="52" width="14" height="12" fill={D}/>
      <circle cx="64" cy="58" r="1.4" fill="#fff"/>
    </g>
  )}

  {name === 'wohn' && (
    <g>
      <rect x="22" y="34" width="76" height="30" rx="2" fill={S}/>
      <path d="M18 34l42-16 42 16z" fill={INK}/>
      <rect x="55" y="46" width="14" height="18" fill={D}/>
      <rect x="32" y="42" width="12" height="10" rx="1" fill="#fff"/>
      <rect x="76" y="42" width="12" height="10" rx="1" fill="#fff"/>
    </g>
  )}

  {name === 'sanitaer' && (
    <g>
      <rect x="26" y="28" width="68" height="36" rx="2" fill={S}/>
      <rect x="34" y="36" width="20" height="20" rx="1" fill="#fff"/>
      <circle cx="44" cy="46" r="5" fill={PAPER}/>
      <path d="M70 34c6 0 6 8 0 8" fill="none" stroke="#fff" stroke-width="2.4"/>
      <line x1="70" y1="42" x2="70" y2="56" stroke="#fff" stroke-width="2.4"/>
      <circle cx="78" cy="52" r="6" fill="none" stroke="#fff" stroke-width="2.4"/>
    </g>
  )}

  {name === 'lager' && (
    <g>
      <rect x="22" y="30" width="76" height="34" rx="2" fill={S}/>
      <g fill={D}><rect x="30" y="34" width="4" height="26"/><rect x="86" y="34" width="4" height="26"/></g>
      <rect x="40" y="34" width="40" height="26" fill={D}/>
      <line x1="60" y1="34" x2="60" y2="60" stroke={PAPER} stroke-width="2"/>
      <circle cx="55" cy="47" r="1.8" fill={PAPER}/><circle cx="65" cy="47" r="1.8" fill={PAPER}/>
    </g>
  )}

  {name === 'see' && (
    <g>
      <rect x="14" y="30" width="44" height="20" rx="1.5" fill={S}/>
      <rect x="62" y="30" width="44" height="20" rx="1.5" fill={D}/>
      <rect x="26" y="14" width="44" height="20" rx="1.5" fill={INK}/>
      <g fill="#fff" opacity="0.85"><rect x="20" y="34" width="3" height="12"/><rect x="30" y="34" width="3" height="12"/><rect x="70" y="34" width="3" height="12"/><rect x="80" y="34" width="3" height="12"/></g>
      <path d="M10 62c6-5 12 5 18 0s12 5 18 0 12 5 18 0 12 5 18 0 12 5 18 0" fill="none" stroke={LINE} stroke-width="2.4"/>
    </g>
  )}

  {name === 'kuehl' && (
    <g>
      <rect x="24" y="28" width="72" height="36" rx="2" fill={S}/>
      <rect x="70" y="33" width="20" height="26" rx="1.5" fill="#fff"/>
      <path d="M60 34v22M52 41l8-4 8 4M52 49l8 4 8-4" stroke={D} stroke-width="2.2" fill="none" stroke-linecap="round"/>
      <circle cx="80" cy="46" r="5" fill="none" stroke={S} stroke-width="2.2"/>
    </g>
  )}

  {name === 'abroll' && (
    <g>
      <path d="M18 58l6-26h56l10 26z" fill={S}/>
      <path d="M24 32l-4 26" stroke={D} stroke-width="2" fill="none"/>
      <path d="M44 32l-1 26M64 32l2 26M80 32l4 26" stroke={D} stroke-width="2" fill="none"/>
      <circle cx="34" cy="64" r="6" fill={INK}/><circle cx="82" cy="64" r="6" fill={INK}/>
      <path d="M90 58l14-4v8z" fill={INK}/>
    </g>
  )}

  {name === 'ruler' && (
    <g>
      <rect x="20" y="36" width="80" height="16" rx="2" fill={S}/>
      <g stroke="#fff" stroke-width="2"><line x1="32" y1="36" x2="32" y2="45"/><line x1="44" y1="36" x2="44" y2="48"/><line x1="56" y1="36" x2="56" y2="45"/><line x1="68" y1="36" x2="68" y2="48"/><line x1="80" y1="36" x2="80" y2="45"/><line x1="92" y1="36" x2="92" y2="48"/></g>
    </g>
  )}

  {name === 'euro' && (
    <g>
      <circle cx="60" cy="42" r="24" fill={S}/>
      <path d="M68 32c-3-3-8-4-12-1-5 3-6 11-1 15 3 3 8 3 12 0" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/>
      <line x1="46" y1="40" x2="62" y2="40" stroke="#fff" stroke-width="3"/>
      <line x1="46" y1="46" x2="60" y2="46" stroke="#fff" stroke-width="3"/>
    </g>
  )}

  {name === 'checklist' && (
    <g>
      <rect x="38" y="18" width="44" height="52" rx="3" fill="#fff" stroke={LINE} stroke-width="2"/>
      <rect x="52" y="14" width="16" height="8" rx="2" fill={INK}/>
      <g stroke={S} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M45 32l3 3 5-6"/><path d="M45 46l3 3 5-6"/><path d="M45 60l3 3 5-6"/>
      </g>
      <g stroke={LINE} stroke-width="2.4"><line x1="58" y1="33" x2="76" y2="33"/><line x1="58" y1="47" x2="76" y2="47"/><line x1="58" y1="61" x2="76" y2="61"/></g>
    </g>
  )}

  {name === 'permit' && (
    <g>
      <rect x="34" y="16" width="52" height="52" rx="3" fill="#fff" stroke={LINE} stroke-width="2"/>
      <g stroke={LINE} stroke-width="2.4"><line x1="42" y1="28" x2="78" y2="28"/><line x1="42" y1="36" x2="78" y2="36"/><line x1="42" y1="44" x2="66" y2="44"/></g>
      <circle cx="74" cy="56" r="13" fill="none" stroke={S} stroke-width="3.2"/>
      <path d="M68 56l4 4 8-9" fill="none" stroke={S} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  )}
</svg>

<style>
  .cicon { width: 100%; height: auto; display: block; }
</style>
