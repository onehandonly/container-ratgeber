---
/**
 * Abgespeckter Leasingrechner (Schnellrechnung) mit Link zum vollständigen Rechner.
 * Gleiche Annahmen wie LeasingCalculator: 6,99 % effektiver Jahreszins, 10 % Restwert.
 * Mehrfach pro Seite einsetzbar – jede Instanz braucht eine eigene id.
 */
import { localizePath, type Lang } from '../lib/i18n';
interface Props { lang: Lang; id: string; eyebrow?: string; title?: string; text?: string }
const { lang, id, eyebrow, title, text } = Astro.props;
const L = (p: string) => localizePath(p, lang);
---
<div class="calc-teaser__card" id={id}>
      <div class="calc-teaser__copy">
        <span class="calc-teaser__eyebrow">{eyebrow ?? (lang === 'en' ? 'New: calculator' : 'Neu: Rechner')}</span>
        <h2 id={`${id}-title`}>{title ?? (lang === 'en' ? 'What does a container cost per month?' : 'Was kostet ein Container im Monat?')}</h2>
        <p>{text ?? (lang === 'en'
          ? 'Work out the leasing instalment in seconds – and compare it with hire purchase, cash purchase and rental in the full calculator.'
          : 'Rechnen Sie die Leasingrate in Sekunden aus – und vergleichen Sie im vollständigen Rechner mit Mietkauf, Barkauf und Miete.')}</p>
        <a href={L('/rechner/leasing')} class="btn btn--lg calc-teaser__btn">{lang === 'en' ? 'Open the leasing calculator' : 'Zum Leasingrechner'} →</a>
      </div>
      <form class="calc-teaser__form" onsubmit="return false" aria-label={lang === 'en' ? 'Quick calculation' : 'Schnellrechnung'}>
        <label>{lang === 'en' ? 'Purchase price, net (€)' : 'Kaufpreis netto (€)'}
          <input type="number" name="price" min="0" step="500" value="10000" inputmode="decimal" />
        </label>
        <label>{lang === 'en' ? 'Term' : 'Laufzeit'}
          <select name="term">{[24, 36, 48, 60].map((m) => <option value={m} selected={m === 36}>{m} {lang === 'en' ? 'months' : 'Monate'}</option>)}</select>
        </label>
        <div class="calc-teaser__out" aria-live="polite">
          <span>{lang === 'en' ? 'Monthly instalment approx.' : 'Monatsrate ca.'}</span>
          <strong data-out="rate">–</strong>
          <small>{lang === 'en'
            ? 'at 6.99% effective annual rate and 10% residual value, net'
            : 'bei 6,99 % effektivem Jahreszins und 10 % Restwert, netto'}</small>
        </div>
      </form>
</div>

<script is:inline define:vars={{ lang, id }}>
  (function () {
    var root = document.getElementById(id);
    if (!root) return;
    var f = root.querySelector('form');
    var fmt = new Intl.NumberFormat(lang === 'de' ? 'de-DE' : 'en-GB', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
    var r = Math.pow(1.0699, 1 / 12) - 1; // gleiche Annahmen wie im vollständigen Rechner
    function calc() {
      var p = Math.max(0, parseFloat(f.elements.price.value) || 0), n = parseInt(f.elements.term.value, 10) || 36;
      var fv = p * 0.10, q = Math.pow(1 + r, n);
      var rate = (p - fv / q) * r / (1 - 1 / q);
      root.querySelector('[data-out=rate]').textContent = p > 0 ? fmt.format(rate) : '–';
    }
    f.addEventListener('input', calc); f.addEventListener('change', calc); calc();
  })();
</script>

<style>
  .calc-teaser__card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.2rem, 1rem + 2vw, 2.5rem); align-items: center; background: var(--grad-brand-deep); color: #fff; border-radius: var(--radius-xl); padding: clamp(1.4rem, 1rem + 2.5vw, 2.6rem); box-shadow: var(--shadow-brand); }
  .calc-teaser__eyebrow { display: inline-block; font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #7fe3f2; }
  .calc-teaser__copy h2 { color: #fff; font-size: var(--text-2xl); margin-top: 0.5rem; letter-spacing: -0.01em; }
  .calc-teaser__copy p { color: rgba(255,255,255,0.86); margin-top: 0.6rem; max-width: 48ch; }
  .calc-teaser__btn { margin-top: 1.3rem; background: #fff; color: var(--color-signal); border-color: #fff; }
  .calc-teaser__btn:hover { background: #eef2fb; color: var(--color-signal-dark); }
  .calc-teaser__form { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.22); border-radius: var(--radius-lg); padding: 1.1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .calc-teaser__form label { display: flex; flex-direction: column; gap: 0.3rem; font-size: var(--text-sm); font-weight: 600; color: #fff; }
  .calc-teaser__form input, .calc-teaser__form select { font: inherit; font-weight: 600; padding: 0.55rem 0.7rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.4); background: #fff; color: var(--color-ink); width: 100%; }
  .calc-teaser__out { grid-column: 1 / -1; background: #fff; color: var(--color-ink); border-radius: var(--radius-md); padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .calc-teaser__out span { font-size: var(--text-xs); color: var(--color-muted); font-weight: 600; }
  .calc-teaser__out strong { font-family: var(--font-head); font-size: var(--text-2xl); color: var(--color-signal); }
  .calc-teaser__out small { font-size: var(--text-xs); color: var(--color-muted); }
  @media (max-width: 820px) { .calc-teaser__card { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .calc-teaser__form { grid-template-columns: 1fr; } }
</style>
