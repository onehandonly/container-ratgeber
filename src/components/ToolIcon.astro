---
/** Einfache Icons für Rechner- und Werkzeug-Karten. */
interface Props { icon: 'calc' | 'box' | 'truck' | 'check' | 'scale' }
const { icon } = Astro.props;
---
<svg viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
  {icon === 'calc' && (<>
    <rect x="10" y="6" width="28" height="36" rx="4" />
    <rect x="15" y="11" width="18" height="7" rx="1.5" fill="currentColor" stroke="none" opacity=".9" />
    <g fill="currentColor" stroke="none"><circle cx="17" cy="25" r="2"/><circle cx="24" cy="25" r="2"/><circle cx="31" cy="25" r="2"/><circle cx="17" cy="32" r="2"/><circle cx="24" cy="32" r="2"/><circle cx="31" cy="32" r="2"/></g>
  </>)}
  {icon === 'scale' && (<>
    <path d="M24 8v32M14 40h20M10 16h28" />
    <path d="M10 16l-5 11a5 5 0 0 0 10 0zM38 16l-5 11a5 5 0 0 0 10 0z" />
  </>)}
  {icon === 'truck' && (<>
    <rect x="4" y="13" width="24" height="17" rx="1.5" />
    <path d="M28 19h8l6 6v5H28z" />
    <circle cx="13" cy="34" r="3.5" /><circle cx="35" cy="34" r="3.5" />
  </>)}
  {icon === 'box' && (<>
    <path d="M24 6l16 8v20l-16 8-16-8V14z" />
    <path d="M8 14l16 8 16-8M24 22v20" />
  </>)}
  {icon === 'check' && (<>
    <rect x="10" y="7" width="28" height="35" rx="3" />
    <path d="M16 18l3 3 5-6M16 30l3 3 5-6M28 19h5M28 31h5" />
  </>)}
</svg>
