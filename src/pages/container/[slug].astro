---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContainerType from '../../components/pages/ContainerType.astro';
import { containerTypes, typeName, typeTeaser } from '../../lib/site';

export async function getStaticPaths() {
  return containerTypes.map((type) => ({ params: { slug: type.slug }, props: { type } }));
}
const { type } = Astro.props;
---
<BaseLayout title={`${typeName(type, 'de')} – Ratgeber & Überblick`} description={typeTeaser(type, 'de')}>
  <ContainerType type={type} lang="de" />
</BaseLayout>
