---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentMode from '../components/ConsentMode.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../lib/site';
import { getLangFromUrl, switchLangPath, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Relativer oder absoluter Pfad zum OG-Bild. */
  ogImage?: string;
  /** false = noindex (z. B. Danke-/Fehlerseiten). */
  index?: boolean;
  /** Zusätzliches JSON-LD (Article, FAQPage, BreadcrumbList …). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Breite Kopfzeile ausblenden (für Startseite mit eigenem Hero). */
}
const {
  title,
  description = site.description,
  canonical,
  ogImage = '/img/og-default.svg',
  index = true,
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// hreflang-Alternates (DE/EN) für zweisprachiges SEO.
const curLang: Lang = getLangFromUrl(Astro.url);
const dePath = curLang === 'de' ? Astro.url.pathname : switchLangPath(Astro.url, 'de');
const enPath = curLang === 'en' ? Astro.url.pathname : switchLangPath(Astro.url, 'en');
const deHref = new URL(dePath, Astro.site).href;
const enHref = new URL(enPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// AdSense/Analytics werden erst aktiv, wenn die IDs als Umgebungsvariablen gesetzt sind.
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined; // GA4, Format "G-XXXXXXX"
const consentNeeded = Boolean(adsenseClient || gtmId || gaId);

// Organisation als JSON-LD (Basis für alle Seiten).
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'de-DE',
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};
const schemas = [orgSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {index && (
      <>
        <link rel="alternate" hreflang="de" href={deHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={deHref} />
      </>
    )}
    <meta name="robots" content={index ? 'index,follow' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#c8102e" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" />
    </noscript>

    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {consentNeeded && <ConsentMode />}

    {/* Google Analytics 4 (gtag.js) – arbeitet mit Consent Mode v2 zusammen:
        Vor Einwilligung werden nur cookielose, modellierte Signale gesendet. */}
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = window.gtag || gtag;
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}

    {/* GTM (optional) */}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    {/* AdSense-Skript – lädt erst nach erteilter Einwilligung. */}
    {adsenseClient && (
      <script is:inline define:vars={{ adsenseClient }}>
        (function () {
          function loadAds() {
            if (window.__adsLoaded) return; window.__adsLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
            document.head.appendChild(s);
          }
          try {
            var c = JSON.parse(localStorage.getItem('cr-consent') || 'null');
            if (c && c.status === 'granted') loadAds();
          } catch (e) {}
          window.addEventListener('cr-consent-changed', function (e) { if (e.detail === 'granted') loadAds(); });
        })();
      </script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {consentNeeded && <CookieBanner />}
  </body>
</html>
